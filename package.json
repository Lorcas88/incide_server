{
  "name": "incide_server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --watch --env-file=.env.development ./src/server.js",
    "start": "cross-env NODE_ENV=production node --env-file=.env.production ./src/server.js",
    "test": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles",
    "migrate": "cross-env NODE_ENV=development node --env-file=.env.development src/database/migrations.js",
    "migrate:test": "cross-env NODE_ENV=test node --env-file=.env.test src/database/migrations.js",
    "migrate:prod": "cross-env NODE_ENV=production node --env-file=.env.production src/database/migrations.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "A simple backend server to an incident applicaction",
  "type": "module",
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.0",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "prisma": "^7.8.0",
    "resend": "^6.8.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.1",
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "yarn@4.14.1"
}
