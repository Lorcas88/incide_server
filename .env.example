# Environment Configuration Example
# Copy this file to .env.development for local development
# For production, copy to .env.production and update with real credentials

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=3000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/incide_db"

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT Secret - IMPORTANT: Generate a strong random secret for production
# You can generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Minimum 32 characters required, 64+ recommended for production
JWT_SECRET=secret

# JWT Token Expiration (examples: 1h, 24h, 7d)
JWT_EXPIRES_IN=1h

# Bcrypt Rounds - Balance between security and performance
# Development/Test: 10 (faster)
# Production: 12 (more secure, slower)
BCRYPT_ROUNDS=10

# =============================================================================
# EMAIL SERVICE CONFIGURATION
# =============================================================================

# Resend API Key - Get yours at: https://resend.com/api-keys
# Required for production, optional for development (will use test key)
RESEND_API_KEY=re_your_api_key_here
MAIL_FROM_NAME=Incide

# =============================================================================
# CLIENT/FRONTEND CONFIGURATION
# =============================================================================

# Frontend URL - Used for CORS and email links
FRONTEND_URL=http://localhost:5173
